# Copier ce fichier en .env (non versionne) : Docker Compose le lit automatiquement.

# Base de donnees (optionnel, "todolist" par defaut).
POSTGRES_DB=todolist
POSTGRES_USER=todolist
POSTGRES_PASSWORD=todolist

# Secret de signature JWT (obligatoire). Generer avec : openssl rand -base64 64
APP_JWT_SECRET=

# Compte administrateur cree au demarrage s'il n'existe pas (optionnel,
# laisser APP_ADMIN_USERNAME vide pour desactiver). Mot de passe : 8 caracteres minimum.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
APP_ADMIN_EMAIL=
